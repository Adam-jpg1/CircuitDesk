{
  "name": "circuitdesk",
  "version": "0.9.0",
  "private": true,
  "description": "CircuitDesk — a realistic electronics project workspace for planning, wiring, coding, validating, simulating, testing, and documenting hardware projects before physically assembling them.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test:pipeline": "tsx tests/pipeline.e2e.mts",
    "test:ui": "tsx tests/ui.smoke.mts",
    "test:sim": "tsx tests/sim.behaviors.mts",
    "test:qa": "tsx tests/qa.beta.mts",
    "start:backend": "node dist-server/index.js",
    "test:boards": "tsx tests/boards.profile.mts",
    "test:mega": "tsx tests/mega.runtime.mts",
    "test:leonardo": "tsx tests/leonardo.runtime.mts",
    "build:server": "tsc -p tsconfig.server.build.json",
    "test:components": "tsx tests/components.i2c.mts",
    "test:rp2040": "tsx tests/rp2040.spike.mts",
    "test:rp2040:abi": "tsx tests/rp2040.romabi.mts",
    "test:rp2040:firmware": "tsx tests/rp2040.firmware.mts",
    "test:rp2040:integration": "tsx tests/rp2040.integration.mts",
    "test:rp2040:buses": "tsx tests/rp2040.buses.mts",
    "test:riscv": "tsx tests/riscv.core.mts",
    "test:esp32c3": "tsx tests/esp32c3.image.mts",
    "test:serial": "tsx tests/sim.serialAttribution.mts",
    "test:validation": "tsx tests/validation.busPins.mts",
    "test:production": "tsx tests/production.multiboard.mts",
    "test:artwork": "tsx tests/artwork.displays.mts",
    "test:artwork:discrete": "tsx tests/artwork.discrete.mts",
    "test:contention": "tsx tests/sim.contention.mts",
    "test:deployment": "tsx tests/compiler.deployment.mts",
    "cores:verify": "node server/compiler/installCores.mjs --verify",
    "cores:install": "node server/compiler/installCores.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@vercel/analytics": "^2.0.1",
    "avr8js": "^0.20.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rp2040js": "^1.3.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
