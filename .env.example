# Frontend (Vite, read at build time):
# Base URL of the deployed compiler backend. Defaults to the local dev server.
VITE_COMPILER_API_URL=http://localhost:3411

# Backend (optional):
# PORT is provided automatically by hosting platforms (Render); defaults to 3411 locally.
# PORT=3411
# Extra comma-separated origins to allow through CORS (e.g. preview deployments).
# CORS_EXTRA_ORIGINS=

# Backend: the community database (projects and likes). Postgres connection
# string; in production set it in the Render dashboard, never in a file that is
# committed. Leave unset locally to use an embedded Postgres in .community-data/.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
