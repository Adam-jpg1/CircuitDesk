// Writes server/community/builtin.json from src/community/builtinProjects.ts.
//
// The server cannot import the app's code (the image ships server/ only), so
// the built-in projects are built here, where the part registry and the preview
// renderer exist, and written out as plain data. Run after changing one:
//
//   npx tsx tools/community/buildBuiltins.mts
//
// tests/community.builtin.mts checks the projects work; tests/community.api.mts
// checks the file matches them.

import { writeFileSync } from 'node:fs';
import path from 'node:path';
import { BUILTIN_PROJECTS } from '../../src/community/builtinProjects';
import { projectPreview } from '../../src/community/preview';
import { resolveDefinition } from '../../src/project/partsRegistry';

const posts = BUILTIN_PROJECTS.map((entry) => {
  const project = entry.build();
  project.name = entry.title;
  const board = project.boardInstances[0];
  const def = board ? resolveDefinition(board.definitionId, project) : undefined;
  const { thumbnailSvg: _t, ...body } = project;
  return {
    id: entry.id,
    title: entry.title,
    description: entry.description,
    // The creator's posts take the creator's name from the server at load, so
    // renaming it is one environment variable rather than a regenerated file.
    authorName: entry.author === 'creator' ? '' : 'Anonymous',
    creator: entry.author === 'creator',
    tags: entry.tags,
    board: def?.name ?? board?.definitionId ?? '',
    boardId: board?.definitionId ?? '',
    partCount: project.boardInstances.length + project.componentInstances.length,
    preview: projectPreview(project),
    project: body,
    createdAt: entry.createdAt,
    builtIn: true,
    baseLikes: entry.baseLikes,
    likers: [],
  };
});

const out = path.resolve('server/community/builtin.json');
writeFileSync(out, JSON.stringify({ _comment: 'Generated by tools/community/buildBuiltins.mts from src/community/builtinProjects.ts.', posts }, null, 1) + '\n');
console.log(`wrote ${posts.length} built-in posts to ${out}`);
